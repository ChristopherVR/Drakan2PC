{
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "default",
    "description": "The editor and save editor windows: app commands by name, event listening. No fs, shell or http access.",
    "windows": ["main", "save"],
    "permissions": [
        "core:event:allow-listen",
        "core:event:allow-unlisten",
        "allow-settings-get",
        "allow-settings-forget",
        "allow-recent-project-forget",
        "allow-iso-pick",
        "allow-iso-open",
        "allow-folder-pick",
        "allow-save-pick-file",
        "allow-save-pick-folder",
        "allow-save-read",
        "allow-save-stat",
        "allow-save-write",
        "allow-file-save-as",
        "allow-mods-read-ini",
        "allow-mods-write-pack",
        "allow-close-ack",
        "allow-close-beat",
        "allow-close-cancel",
        "allow-mods-zip-size",
        "allow-mods-write-zip",
        "allow-game-launch",
        "allow-game-running",
        "allow-project-new",
        "allow-project-open",
        "allow-project-open-path",
        "allow-project-write",
        "allow-project-file-write",
        "allow-folder-reveal",
        "allow-window-open"
    ]
}
