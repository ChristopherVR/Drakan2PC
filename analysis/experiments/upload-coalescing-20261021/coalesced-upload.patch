+++ b/runtime/gs/src/rt_dirty_runs.h
@@ -0,0 +1,10 @@
+#pragma once
+#include <cstdint>
+namespace gsr {
+// first is known dirty. Never include a clean row: it may contain GPU-only data.
+template<class Dirty> uint32_t dirtyRunEnd(uint32_t first,uint32_t count,Dirty dirty) {
+    uint32_t end=first+1;
+    while(end<count && dirty(end))++end;
+    return end;
+}
