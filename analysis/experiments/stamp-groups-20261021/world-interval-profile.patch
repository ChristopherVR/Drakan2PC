+    // Diagnostic intervals between distinct completed world epochs, not
+    // physical display latency or the game's simulation-step timer.
+    void worldFrame(bool world,unsigned long long epoch) {
+        if(!enabled)return;
+        if(!world || !epoch){lastWorld={};lastEpoch=0;worldCount=0;worldSum=0;worldOver7=worldOver16=worldOver33=0;return;}
+        if(epoch==lastEpoch)return;
+        const auto now=Clock::now();lastEpoch=epoch;
+        if(lastWorld==Clock::time_point{}){lastWorld=worldWindow=now;return;}
+        const double ms=std::chrono::duration<double,std::milli>(now-lastWorld).count();lastWorld=now;
+        worldIntervals[worldCount++]=ms;worldSum+=ms;
+        worldOver7+=ms>1000.0/144;worldOver16+=ms>1000.0/60;worldOver33+=ms>1000.0/30;
+        if(worldCount==worldIntervals.size() || std::chrono::duration<double>(now-worldWindow).count()>=2) {
+            std::sort(worldIntervals.begin(),worldIntervals.begin()+worldCount);
+            const auto quantile=[&](size_t numerator){return worldIntervals[(worldCount*numerator+99)/100-1];};
+            std::fprintf(stderr,"[gsr-world-intervals] n=%zu mean_ms=%.3f p50_ms=%.3f p95_ms=%.3f p99_ms=%.3f max_ms=%.3f over144=%u over60=%u over30=%u\n",worldCount,worldSum/worldCount,quantile(50),quantile(95),quantile(99),worldIntervals[worldCount-1],worldOver7,worldOver16,worldOver33);
+            worldCount=0;worldSum=0;worldOver7=worldOver16=worldOver33=0;worldWindow=now;
+        }
     }
