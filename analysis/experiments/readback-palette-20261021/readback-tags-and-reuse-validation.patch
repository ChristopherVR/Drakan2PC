+        ctx->CopyResource(copy.Get(),texture);
+        for(UINT l=0;l<desc.MipLevels;++l) {
+            const UINT w=std::max(1u,desc.Width>>l),h=std::max(1u,desc.Height>>l);
+            if(l>=levels.size() || levels[l].size()!=size_t(w)*h)std::abort();
+            D3D11_MAPPED_SUBRESOURCE mapped{};
+            if(FAILED(ctx->Map(copy.Get(),l,D3D11_MAP_READ,0,&mapped)))std::abort();
