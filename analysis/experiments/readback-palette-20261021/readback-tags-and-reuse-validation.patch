+            ctx->Unmap(copy.Get(),l);
+            if(!same){std::fprintf(stderr,"[texture-reuse-check] MISMATCH mip=%u\n",l);std::abort();}
+            textureReusePixels+=uint64_t(w)*h;
+        }
+        ++textureReuseChecks;
+        std::fprintf(stderr,"[texture-reuse-check] checked=%u pixels=%llu mismatches=0\n",textureReuseChecks,textureReusePixels);
