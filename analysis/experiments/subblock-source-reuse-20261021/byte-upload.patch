+bool Backend::deferSubblockUpload(uint32_t bp) {
+    // Validate all aliases before changing ownership for any of them.
+    for(auto& r:m_impl->rts) {
+        if(!r->dirty)continue;
+        uint32_t lo,hi;m_impl->rowSpan(*r,r->dy0,std::min(r->dy1,r->h),lo,hi);
+        if(bp<lo || bp>hi)continue;
+        if(r->psm!=PSM_CT32 || r->wstate!=0 || r->w!=r->fbw*64 || hi>=kVramBlocks)return false;
+    }
+    for(auto& r:m_impl->rts) {
+        if(!r->dirty)continue;
+        uint32_t lo,hi;m_impl->rowSpan(*r,r->dy0,std::min(r->dy1,r->h),lo,hi);
+        if(bp<lo || bp>hi)continue;
+        if(r->cpuBlocks.empty())r->cpuBlocks.resize(kVramBlocks,0);
+        if(r->cpuBlocks[bp])continue;
+        CpuProfile::Scope defer(m_impl->cpuProfile,CpuProfile::SubblockDefer);
+        auto& mask=r->cpuBytes[bp];
+        for(unsigned y=0;y<8;++y)for(unsigned x=0;x<8;++x)mask[tables::col8[y][x]]=1;
+        r->copyValid=false;
+    }
+    return true;
+}
