+++ b/runtime/gs/src/rt_color_decode.h
@@ -0,0 +1,26 @@
+#pragma once
+#include "gs_mem.h"
+#include <algorithm>
+namespace gsr {
+// Color render targets only. Other storage formats retain the reference reader.
+inline bool decodeColorRows(const LocalMemory& mem,uint32_t psm,uint32_t bp,uint32_t bw,
+                            uint32_t width,uint32_t y0,uint32_t rows,uint32_t* out) {
+    if(psm!=PSM_CT32 && psm!=PSM_CT24)return false;
+    for(uint32_t row=0;row<rows;++row) {
+        const uint32_t y=y0+row;
+        const uint32_t rowBase=bp*256u+(y>>5)*(bw?bw:1u)*8192u;
+        const auto* blocks=tables::block32[(y>>3)&3];
+        const auto* columns=tables::col32[y&7];
+        for(uint32_t x=0;x<width;x+=8) {
+            const uint32_t base=(rowBase+(x>>6)*8192u+blocks[(x>>3)&7]*256u)&(kVramSize-1);
+            const uint32_t n=std::min(8u,width-x);
+            for(uint32_t i=0;i<n;++i) {
+                uint32_t value;
+                std::memcpy(&value,mem.data()+base+columns[i]*4u,4);
+                out[size_t(row)*width+x+i]=psm==PSM_CT24 ? ((value&0xffffffu)|0x80000000u) : value;
+            }
+        }
+    }
+    return true;
+}
+}
