+void Backend::discardCompleteUpload(uint32_t first,uint32_t last) {
+    for(auto& r:m_impl->rts) {
+        if(!r->dirty || r->psm!=PSM_CT32 || r->wstate!=0 || r->w!=r->fbw*64 || r->dy1<=r->dy0)continue;
+        uint32_t lo,hi;m_impl->rowSpan(*r,r->dy0,std::min(r->dy1,r->h),lo,hi);
+        if(lo<first || hi>last)continue;
+        CpuProfile::Scope discard(m_impl->cpuProfile,CpuProfile::ReadbackOverwriteDiscard);
+        r->dirty=false;r->copyValid=false;
+        // startTransfer will stamp the incoming full-block write. Preserve
+        // seen/rowStamp so syncRT uploads the replacement before GPU reuse.
+    }
+}
 void Backend::flushAll() { m_impl->flushAll(); }
