+// Called only at the final packed qword of a GIF tag. The next tag and its
+// payload are in this same submission, under the renderer lock.
+inline uint32_t followingImageBytes(const uint8_t* current,uint32_t size) {
+ if(size<32)return 0;
+ uint64_t tag;std::memcpy(&tag,current+16,8);
+ if(((tag>>58)&3)!=2)return 0;
+ return std::min(uint32_t(tag&0x7fff), (size-32)/16)*16;
+}
+inline bool fullUploadBlocks(uint32_t psm,uint32_t bp,uint32_t bw,uint32_t x,uint32_t y,uint32_t w,uint32_t h,uint32_t available,uint32_t& first,uint32_t& last) {
+ if((psm!=PSM_CT32 && psm!=PSM_T8) || !bw || x || y || !w || !h || w>2048 || h>2048 || w!=bw*64)return false;
+ const auto g=geomOf(psm);
+ if(w%g.pageW || h%g.pageH)return false;
+ const uint64_t bytes=uint64_t(w)*h*(psm==PSM_CT32?4:1);
+ if(bytes>available)return false;
+ const uint64_t blocks=bytes/256;
+ if(!blocks || uint64_t(bp)+blocks>kVramBlocks)return false;
+ first=bp;last=bp+uint32_t(blocks)-1;return true;
+}
+}
