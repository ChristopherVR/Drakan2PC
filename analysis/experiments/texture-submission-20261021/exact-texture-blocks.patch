+// Exact storage-block footprint for a decoded mip starting at pixel (0,0).
+// Keep render-target coherence flushes conservative; narrow only RAM stamps.
+inline void appendTextureBlocks(std::vector<uint16_t>& out, uint32_t psm,
+                                uint32_t bp, uint32_t bw, uint32_t w, uint32_t h)
+{
+    const auto g = geomOf(psm);
+    for (uint32_t y = 0; y < h; y += g.blockH)
+        for (uint32_t x = 0; x < w; x += g.blockW)
+            out.push_back(static_cast<uint16_t>(blockOf(psm,bp,bw,x,y)));
+}
