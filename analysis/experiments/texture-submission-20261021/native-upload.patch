+#pragma once
+#include <d3d11.h>
+#include <d3dcompiler.h>
+#include <wrl/client.h>
+#include <cstdint>
+namespace gsr {
+class NativeUpload {
+    template<class T> using Ptr=Microsoft::WRL::ComPtr<T>;
+    Ptr<ID3D11ComputeShader> shader;
+    Ptr<ID3D11Buffer> constants;
+    Ptr<ID3D11Texture2D> input, texture;
+    Ptr<ID3D11ShaderResourceView> source;
+    Ptr<ID3D11UnorderedAccessView> output;
+    uint32_t iw=0,ih=0,ow=0,oh=0;
+public:
+    ID3D11Texture2D* expand(ID3D11Device* dev,ID3D11DeviceContext* ctx,
+                           const uint32_t* pixels,uint32_t w,uint32_t rows,uint32_t scale) {
+        if(!w || !rows || !scale || w>16384/scale || rows>16384/scale) return nullptr;
+        if(!shader) {
+            static constexpr char code[]=R"(
+Texture2D<float4> source : register(t0);
+RWTexture2D<unorm float4> output : register(u0);
+cbuffer Constants : register(b0) { uint width, rows, scale, unused; };
+[numthreads(8,8,1)] void main(uint3 p:SV_DispatchThreadID) {
+    if(p.x<width*scale && p.y<rows*scale)
+        output[p.xy]=source.Load(int3(p.xy/scale,0));
+})";
+            Ptr<ID3DBlob> binary,errors;
+            if(FAILED(D3DCompile(code,sizeof(code)-1,"native_upload",nullptr,nullptr,"main","cs_5_0",D3DCOMPILE_OPTIMIZATION_LEVEL3,0,&binary,&errors)))return nullptr;
+            if(FAILED(dev->CreateComputeShader(binary->GetBufferPointer(),binary->GetBufferSize(),nullptr,&shader)))return nullptr;
+            D3D11_BUFFER_DESC cb{};cb.ByteWidth=16;cb.BindFlags=D3D11_BIND_CONSTANT_BUFFER;
+            if(FAILED(dev->CreateBuffer(&cb,nullptr,&constants))){shader.Reset();return nullptr;}
+        }
+        if(!input || iw<w || ih<rows) {
+            source.Reset();input.Reset();iw=ih=0;
+            D3D11_TEXTURE2D_DESC d{};d.Width=w;d.Height=rows;d.MipLevels=d.ArraySize=d.SampleDesc.Count=1;
+            d.Format=DXGI_FORMAT_R8G8B8A8_UNORM;d.BindFlags=D3D11_BIND_SHADER_RESOURCE;
+            if(FAILED(dev->CreateTexture2D(&d,nullptr,&input)) || FAILED(dev->CreateShaderResourceView(input.Get(),nullptr,&source))){input.Reset();return nullptr;}
+            iw=w;ih=rows;
+        }
+        if(!texture || ow<w*scale || oh<rows*scale) {
+            output.Reset();texture.Reset();ow=oh=0;
+            D3D11_TEXTURE2D_DESC d{};d.Width=w*scale;d.Height=rows*scale;d.MipLevels=d.ArraySize=d.SampleDesc.Count=1;
+            d.Format=DXGI_FORMAT_R8G8B8A8_UNORM;d.BindFlags=D3D11_BIND_UNORDERED_ACCESS;
+            if(FAILED(dev->CreateTexture2D(&d,nullptr,&texture)) || FAILED(dev->CreateUnorderedAccessView(texture.Get(),nullptr,&output))){texture.Reset();return nullptr;}
+            ow=w*scale;oh=rows*scale;
+        }
+        const D3D11_BOX box{0,0,0,w,rows,1};
+        ctx->UpdateSubresource(input.Get(),0,&box,pixels,w*4,0);
+        const uint32_t values[]={w,rows,scale,0};ctx->UpdateSubresource(constants.Get(),0,nullptr,values,0,0);
+        Ptr<ID3D11ComputeShader> oldShader;Ptr<ID3D11Buffer> oldConstants;
+        Ptr<ID3D11ShaderResourceView> oldSource;Ptr<ID3D11UnorderedAccessView> oldOutput;
+        ID3D11ClassInstance* classes[256]{};UINT classCount=256;
+        ctx->CSGetShader(&oldShader,classes,&classCount);ctx->CSGetConstantBuffers(0,1,&oldConstants);
+        ctx->CSGetShaderResources(0,1,&oldSource);ctx->CSGetUnorderedAccessViews(0,1,&oldOutput);
+        auto* cb=constants.Get();auto* srv=source.Get();auto* uav=output.Get();
+        ctx->CSSetShader(shader.Get(),nullptr,0);ctx->CSSetConstantBuffers(0,1,&cb);
+        ctx->CSSetShaderResources(0,1,&srv);ctx->CSSetUnorderedAccessViews(0,1,&uav,nullptr);
+        ctx->Dispatch((w*scale+7)/8,(rows*scale+7)/8,1);
+        srv=nullptr;uav=nullptr;ctx->CSSetShaderResources(0,1,&srv);ctx->CSSetUnorderedAccessViews(0,1,&uav,nullptr);
+        cb=oldConstants.Get();srv=oldSource.Get();uav=oldOutput.Get();
+        ctx->CSSetShader(oldShader.Get(),classes,classCount);ctx->CSSetConstantBuffers(0,1,&cb);
+        ctx->CSSetShaderResources(0,1,&srv);ctx->CSSetUnorderedAccessViews(0,1,&uav,nullptr);
+        for(UINT i=0;i<classCount;++i)if(classes[i])classes[i]->Release();
+        return texture.Get();
+    }
+};
+}
