+++ b/ps2xRuntime/tests/vu_native_loop_tests.cpp
@@ -0,0 +1,97 @@
+#include "vu/aot/ps2_vu1_aot.h"
+#include "vu/ref/ps2_vu1_ref.h"
+#include "vu/aot/ps2_vu1_image.inc"
+#include "runtime/gs/gs_frontend.h"
+#include <array>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <memory>
+#include <random>
+#include <vector>
+namespace Vu1Aot { void registerBlocks0(); }
+static bool same(const VU1State& a,const VU1State& b)
+{
+    return !std::memcmp(a.vf,b.vf,sizeof a.vf) && !std::memcmp(a.vi,b.vi,sizeof a.vi) &&
+        !std::memcmp(a.acc,b.acc,sizeof a.acc) && !std::memcmp(&a.q,&b.q,sizeof(float)*3) &&
+        a.r==b.r && a.pc==b.pc && a.mac==b.mac && a.clip==b.clip && a.status==b.status && a.cycles==b.cycles &&
+        a.ebit==b.ebit && a.haltAfterDelaySlot==b.haltAfterDelaySlot && a.dBitEnabled==b.dBitEnabled &&
+        a.tBitEnabled==b.tBitEnabled && a.stoppedByD==b.stoppedByD && a.stoppedByT==b.stoppedByT &&
+        a.top==b.top && a.itop==b.itop && a.branchPending==b.branchPending &&
+        a.branchTarget==b.branchTarget && a.branchDelay==b.branchDelay;
+}
+
+static void selectMode(const char* mode)
+{
+#if defined(_WIN32)
+    _putenv_s("DRAKAN_VU_NATIVE_LOOPS",mode);
+#else
+    setenv("DRAKAN_VU_NATIVE_LOOPS",mode,1);
+#endif
+}
+int main(int argc,char** argv)
+{
+    GS gs;
+    std::vector<uint64_t> code(std::begin(kVu1Image),std::end(kVu1Image));
+    auto* bytes=reinterpret_cast<uint8_t*>(code.data());
+    const uint32_t size=uint32_t(code.size()*8);
+    if(!Vu1Aot::imageMatches(bytes,size))return 1;
+    selectMode("0");Vu1Aot::registerBlocks0();
+    std::vector<Vu1Aot::Fn> ordinary(Vu1Aot::g_dispatch,Vu1Aot::g_dispatch+Vu1Aot::kPairs);
+    selectMode(argc>1?argv[1]:"1");Vu1Aot::registerBlocks0();
+    std::vector<Vu1Aot::Fn> chained(Vu1Aot::g_dispatch,Vu1Aot::g_dispatch+Vu1Aot::kPairs);
+    const uint32_t entries[]={55,155,188,334};
+    for(auto pc:entries)if(ordinary[pc]==chained[pc])return 2;
+    auto a=std::make_unique<VU1Interpreter>(), b=std::make_unique<VU1Interpreter>();
+    std::array<uint8_t,16384> da{},db{};
+    std::vector<std::vector<uint8_t>> pa,pb;
+    a->setPacketTap(&pa);b->setPacketTap(&pb);
+    std::mt19937 rng(0x1951ec);
+    unsigned checks=0;
+    for(uint32_t trial=0;trial<2048;++trial)
+    {
+        a->reset();b->reset();pa.clear();pb.clear();
+        Vu1Fast::spare(*a).sinkNone=Vu1Fast::spare(*b).sinkNone=1;
+        da.fill(0);
+        for(unsigned i=0;i<32;++i)for(float& lane:a->state().vf[i])lane=float(int(rng()%33)-16)/4.0f;
+        for(unsigned i=1;i<16;++i)a->state().vi[i]=rng()%9;
+        for(float& lane:a->state().acc)lane=float(int(rng()%33)-16)/4.0f;
+        a->state().mac=rng()&0xffff;a->state().status=rng()&0xfff;a->state().clip=rng()&0xffffff;
+        b->state()=a->state();db=da;
+        const uint32_t pc=entries[trial%4]*8u, budget=1u+(trial/4)%256;
+        if(trial&1024u) {
+            uint64_t prime=0x000002ff800313bcull;
+            switch((trial/4)%6) {
+            case 1:prime=0x000002ff800313bdull;break;
+            case 2:prime=0x000002ff800313beull;break;
+            case 3:prime=uint64_t((15u<<21)|(3u<<16)|(2u<<11)|(10u<<6)|0x28u)<<32|0x8000033cull;break;
+            case 4:prime=uint64_t((15u<<21)|(3u<<16)|(2u<<11)|0x2bcu)<<32|0x8000033cull;break;
+            case 5:prime=0x000002ff100b5801ull;break;
+            }
+            a->execute(reinterpret_cast<uint8_t*>(&prime),8,da.data(),da.size(),gs,nullptr,0,0,0,1);
+            b->execute(reinterpret_cast<uint8_t*>(&prime),8,db.data(),db.size(),gs,nullptr,0,0,0,1);
+            a->state().pc=b->state().pc=pc;
+            std::copy(ordinary.begin(),ordinary.end(),Vu1Aot::g_dispatch);
+            a->resume(bytes,size,da.data(),da.size(),gs,nullptr,0,0,budget);
+            std::copy(chained.begin(),chained.end(),Vu1Aot::g_dispatch);
+            b->resume(bytes,size,db.data(),db.size(),gs,nullptr,0,0,budget);
+        } else {
+            std::copy(ordinary.begin(),ordinary.end(),Vu1Aot::g_dispatch);
+            a->execute(bytes,size,da.data(),da.size(),gs,nullptr,pc,0,0,budget);
+            std::copy(chained.begin(),chained.end(),Vu1Aot::g_dispatch);
+            b->execute(bytes,size,db.data(),db.size(),gs,nullptr,pc,0,0,budget);
+        }
+        if(!same(a->state(),b->state())||da!=db||pa!=pb) {
+            std::printf("native loop mismatch trial=%u pc=%u budget=%u cycles=%llu/%llu endpc=%u/%u\n",trial,pc/8,budget,(unsigned long long)a->state().cycles,(unsigned long long)b->state().cycles,a->state().pc,b->state().pc);return 3;
+        }
+        // Resume across the boundary to expose any disagreement in pending writes.
+        a->state().pc=b->state().pc=0;
+        a->state().branchPending=b->state().branchPending=false;
+        uint64_t nop=0x000002ff8000033cull;
+        a->resume(reinterpret_cast<uint8_t*>(&nop),8,da.data(),da.size(),gs,nullptr,0,0,16);
+        b->resume(reinterpret_cast<uint8_t*>(&nop),8,db.data(),db.size(),gs,nullptr,0,0,16);
+        if(!same(a->state(),b->state())||da!=db||pa!=pb)return 4;
+        checks+=2;
+    }
+    std::printf("PASS: %u native-loop state/data/packet comparisons, budgets 1..256, four entry PCs, pending DIV/SQRT/RSQRT/VF/ACC/VI and resumed tails\n",checks);
+}
diff --git a/ps2xRuntime/tests/vu_normalized_lane_tests.cpp b/ps2xRuntime/tests/vu_normalized_lane_tests.cpp
new file mode 100644
--- /dev/null
+++ b/ps2xRuntime/tests/vu_normalized_lane_tests.cpp
@@ -0,0 +1,64 @@
+#include "vu/ps2_vu1_step.h"
+#include "vu/ps2_vu1_decode.h"
+#include "vu/ps2_vu1_normalized_lanes.h"
+#include "runtime/gs/gs_frontend.h"
+#include <array>
+#include <bit>
+#include <cfenv>
+#include <cstdio>
+#include <cstring>
+#include <memory>
+#include <random>
+
+template<unsigned Mask> static void issue(VU1Interpreter& v,const Vu1Step::Dec& d,Vu1Step::Ctx& c,uint64_t cycle)
+{ Vu1Step::blockPair<false,false,Mask>(v,d,c,cycle,0); }
+int main()
+{
+    auto plain=std::make_unique<VU1Interpreter>();
+    auto proven=std::make_unique<VU1Interpreter>();
+    GS gs;
+    std::array<uint8_t,16384> data{};
+    std::mt19937 rng(0x144fa57);
+    for(auto& b:data) b=uint8_t(rng());
+    using Fn=void(*)(VU1Interpreter&,const Vu1Step::Dec&,Vu1Step::Ctx&,uint64_t);
+    const Fn functions[]={issue<0>,issue<1>,issue<2>,issue<3>,issue<4>,issue<5>,issue<6>,issue<7>};
+    unsigned checks=0,skipped=0;
+    for(int mode:{FE_TONEAREST,FE_TOWARDZERO,FE_DOWNWARD,FE_UPWARD}) {
+        std::fesetround(mode);
+        plain->reset();proven->reset();
+        for(auto& vf:plain->state().vf)for(float& f:vf)f=std::bit_cast<float>(rng());
+        for(float& f:plain->state().acc)f=std::bit_cast<float>(rng());
+        plain->state().vf[0][0]=plain->state().vf[0][1]=plain->state().vf[0][2]=0;
+        plain->state().vf[0][3]=1;
+        proven->state()=plain->state();
+        Vu1SelectedNormalized::State known;
+        Vu1Step::Ctx a{~0ull,data.data(),uint32_t(data.size()),&gs,nullptr,16384,false,0},b=a;
+        for(unsigned n=0;n<50000;++n) {
+            const unsigned fs=1+rng()%7,ft=1+rng()%7,fd=1+rng()%7,dest=rng()%16;
+            // Include full writes often enough to prove vector inputs; partial
+            // writes and raw loads/conversions must invalidate individual lanes.
+            const unsigned lanes=(n%3==0)?15:dest;
+            const unsigned ops[]={0x28,0x2c,0x2a,0x29,0x2d,0x00,0x08,0x18,0x1c};
+            uint32_t upper=(lanes<<21)|(ft<<16)|(fs<<11)|(fd<<6)|ops[rng()%9];
+            uint32_t lower=0x8000033cu;
+            if(n%13==0)lower=(lanes<<21)|(ft<<16); // raw LQ into VF, VI00 base
+            if(n%17==0)upper=(lanes<<21)|(ft<<16)|(fs<<11)|0x17cu; // FTOI0 raw integer bits
+            if(n%19==0)upper=(lanes<<21)|(ft<<16)|(fs<<11)|0x2bcu; // MUL accumulator
+            if(n%23==0){upper|=0x80000000u;lower=rng();} // immediate is normalized independently
+            const auto d=Vu1Decode::decodePair(lower,upper,true);
+            const uint8_t mask=known.inputs(d);
+            issue<0>(*plain,d,a,n);
+            functions[mask](*proven,d,b,n);
+            Vu1Fast::settleFlags(*plain);Vu1Fast::settleFlags(*proven);
+            const auto& x=plain->state();const auto& y=proven->state();
+            if(std::memcmp(x.vf,y.vf,sizeof x.vf)||std::memcmp(x.acc,y.acc,sizeof x.acc)||x.mac!=y.mac||x.status!=y.status||std::memcmp(&x.i,&y.i,sizeof(float))) {
+                std::printf("selected-lane normalized-input mismatch mode=%d pair=%u mask=%u upper=%x lower=%x\n",mode,n,mask,upper,lower);return 1;
+            }
+            known.apply(d);++checks;
+            if ((d.upper >> 21) & 15u) skipped+=std::popcount(unsigned(mask) & (d.fmKind>=4 ? 7u : 3u));
+        }
+    }
+    std::fesetround(FE_TONEAREST);
+    if(skipped<1000)return 2;
+    std::printf("%u selected-lane normalized-input pair comparisons, %u proven operand normalizations skipped; four host rounding modes\n",checks,skipped);
+}
